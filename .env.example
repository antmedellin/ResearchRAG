# =============================================================================
# Application
# =============================================================================

APP_PORT=8080

# =============================================================================
# Platform switches  (vllm | ollama)  -- the ONLY lines you change to switch
# =============================================================================
CHAT_PLATFORM=ollama
DECISION_PLATFORM=ollama


# =============================================================================
# Chat model
# =============================================================================
CHAT_API=openai
CHAT_URL=http://llama-swap:8080/v1/chat/completions
# 25k sequence: 20k input/context + up to 5k output
CHAT_NUM_CTX=20000
CHAT_NUM_PREDICT=5000
CHAT_MAX_SOURCE_CHARS=50000
RAG_TOP_K=50
ANSWER_GUARD_MODE=fallback

# vLLM chat
VLLM_IMAGE=vllm/vllm-openai:v0.33.0
VLLM_CHAT_MODEL=google/gemma-4-12B-it-qat-w4a16-ct
VLLM_CHAT_SERVED_MODEL=gemma4-12b
VLLM_CHAT_MAX_MODEL_LEN=25000
VLLM_CHAT_GPU_UTIL=0.8
VLLM_CHAT_PORT=18001

# Ollama chat
OLLAMA_CHAT_MODEL=gemma4:12b

# =============================================================================
# Decision model
# =============================================================================
DECISION_URL=http://llama-swap:8080/v1/systemone

# vLLM decision
VLLM_DECISION_MODEL=Cloudflare/clef-flash
VLLM_DECISION_SERVED_MODEL=clef-flash-vllm
VLLM_DECISION_MAX_MODEL_LEN=4096
VLLM_DECISION_GPU_UTIL=0.90
VLLM_DECISION_PORT=18003

# Ollama decision
OLLAMA_DECISION_MODEL=clef-flash:9b

# =============================================================================
# Ollama server
# =============================================================================
OLLAMA_IMAGE=ollama/ollama:0.40.16
# Applies to every Ollama model. Use 25000 when CHAT_PLATFORM=ollama, else 4096.
# OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_CONTEXT_LENGTH=25000

# =============================================================================
# Dense embedding - Ollama
# =============================================================================
DENSE_EMBED_PLATFORM=ollama
DENSE_EMBEDDING_MODEL=mxbai-embed-large:335m
DENSE_EMBED_DIMENSION=1024
DENSE_EMBEDDING_URL=http://llama-swap:8080/v1/embeddings
EMBED_API=openai


# =============================================================================
# Reranker - Hugging Face TEI
# =============================================================================
RERANK_PLATFORM=huggingface
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_URL=http://llama-swap:8080/rerank
RERANK_MIN_SCORE=0.05
RERANK_CANDIDATES=100
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:120-1.9

# =============================================================================
# llama-swap
# =============================================================================

LLAMA_SWAP_IMAGE=ghcr.io/mostlygeek/llama-swap:unified-cuda13
LLAMA_SWAP_PORT=9292


# =============================================================================
# Qdrant
# =============================================================================

QDRANT_IMAGE=qdrant/qdrant:v1.20.2
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

QDRANT_COLLECTION=researcher_rag
QDRANT_TEST_COLLECTION=researcher_rag_smoke_test

BM25_AVG_LEN=70


# =============================================================================
# Neo4j
# =============================================================================

NEO4J_IMAGE=neo4j:2026.10.2-community-ubi10
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password


# =============================================================================
# External data
# =============================================================================

OPENALEX_MAILTO=your-utrgv-email@utrgv.edu


# other data
FACULTY_MATCH_MAX_AREAS=6
FACULTY_MATCH_AREA_TOP_FACULTY=20
